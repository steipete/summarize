FROM node:24-slim

# Install yt-dlp and ffmpeg (required for audio extraction)
RUN apt-get update && apt-get install -y python3 python3-pip ffmpeg curl && \
    curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp && \
    chmod a+rx /usr/local/bin/yt-dlp && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Keep workspace resolution and security patches identical to local installs.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig*.json ./
COPY patches/ ./patches/
COPY packages/core/package.json packages/core/tsconfig*.json ./packages/core/
COPY apps/chrome-extension/package.json ./apps/chrome-extension/

RUN corepack enable && corepack install

# The install's prepare script builds the CLI and core after source is present.
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY packages/core/src/ ./packages/core/src/
COPY packages/core/scripts/ ./packages/core/scripts/
COPY packages/core/vendor/ ./packages/core/vendor/

RUN CI=true pnpm install --frozen-lockfile

# Default: run the CLI
ENTRYPOINT ["pnpm", "summarize"]
